# NEXORA AI - Environment Configuration
# One Intelligence. Infinite Possibilities.

# Application Server
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5500
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini API (Primary Conversational & Multimodal Provider)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hugging Face Inference API (Optional, for open-source models)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Storage Paths
UPLOAD_DIR=backend/storage/uploads
GENERATED_IMAGE_DIR=backend/storage/generated_images
GENERATED_VIDEO_DIR=backend/storage/generated_videos
DATABASE_URL=sqlite:///./nexora.db

# Max File Size Limits (in MB)
MAX_FILE_SIZE_MB=50

